# Public URLs. Optional during local development.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Public environment label: development, preview, production, or test.
NEXT_PUBLIC_APP_ENV=development

# Future Supabase server configuration. Not used until CORE-03.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Private server secrets. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
BRAPI_TOKEN=
