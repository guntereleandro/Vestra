# Public URLs. Optional during local development.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Public environment label: development, preview, production, or test.
NEXT_PUBLIC_APP_ENV=development

# Public Supabase Auth configuration. Required when authentication is enabled.
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key for new projects. The legacy anon key name is also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin key is optional until a trusted server-only administrative flow exists.
# Prefer the current secret key. The legacy service_role name remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Other private server secrets. Never prefix these variables with NEXT_PUBLIC_.
BRAPI_TOKEN=
